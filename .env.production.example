# Copy to .env.production on the host. Never commit or publish the real file.
APP_URL=https://your-domain.example
HOST_PORT=3000

# Use a managed PostgreSQL database with TLS enabled.
DATABASE_URL=postgresql://viralflow:replace-this-password@db.example.com:5432/viralflow?schema=public&sslmode=require

# Configure a verified sender/domain with your SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-this-user
SMTP_PASSWORD=replace-this-password
SMTP_FROM=VIRALFLOW <no-reply@your-domain.example>
