# PostgreSQL connection. Use a least-privilege app user; never commit real credentials.
DATABASE_URL="postgresql://viralflow:change-me@localhost:5432/viralflow?schema=public"

# Account email delivery. Configure an SMTP provider before enabling registration.
APP_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="VIRALFLOW <no-reply@example.com>"

# Optional provider credentials. Keep all secrets server-side.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PREMIUM_PRICE_ID=""

# Optional private object storage. Do not expose credentials to the browser.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
